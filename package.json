{
  "name": "arcade-district",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run build:rts && next build",
    "start": "tsx server/index.ts --production",
    "test": "npm run build:rts && vitest run",
    "typecheck": "npm run build:rts && tsc --noEmit",
    "test:e2e": "npm run build:rts && playwright test",
    "preview": "tsx server/index.ts --preview",
    "test:offline": "playwright test --config=playwright.offline.config.ts",
    "build:rts": "tsc -b tsconfig.rts.json && node scripts/build-rts-client.mjs",
    "test:rts": "npm run build:rts && vitest run tests/rts",
    "demo:rts": "npm run build:rts && node scripts/rts-demo.mjs",
    "benchmark:rts": "npm run build:rts && node scripts/rts-benchmark.mjs",
    "demo:rts:world": "npm run build:rts && node scripts/rts-world-demo.mjs",
    "benchmark:rts:world": "npm run build:rts && node scripts/rts-world-demo.mjs --large",
    "predev": "npm run build:rts",
    "test:fps": "npm run build:fps && vitest run tests/fps",
    "demo:fps": "npm run build:fps && node scripts/fps-demo.mjs",
    "build:fps": "tsc -b packages/shared/tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
